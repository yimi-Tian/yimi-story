{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.example/schemas/publication.schema.json",
  "title": "ApprovedContentPublication",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentType", "status", "data", "media"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "contentType": { "enum": ["class_result", "activity"] },
    "status": { "const": "approved" },
    "data": {
      "oneOf": [
        { "$ref": "class-result.schema.json" },
        { "$ref": "activity.schema.json" }
      ]
    },
    "media": {
      "type": "array",
      "maxItems": 31,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/media" }
    }
  },
  "$defs": {
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "sortOrder", "url", "altText", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "role": { "enum": ["cover", "gallery"] },
        "sortOrder": { "type": "integer", "minimum": 0, "maximum": 30 },
        "url": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "altText": { "type": "string", "minLength": 2, "maxLength": 150 },
        "source": { "enum": ["github_legacy", "supabase_upload"] }
      }
    }
  }
}

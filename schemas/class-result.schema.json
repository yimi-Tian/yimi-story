{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.example/schemas/class-result.schema.json",
  "title": "ClassResultData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "year",
    "title",
    "className",
    "instructor",
    "description",
    "districts",
    "venue",
    "tags",
    "sdgs",
    "displayOrder",
    "internalNotes",
    "publicNotes",
    "coverAssetId",
    "galleryAssetIds"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^CR-\\d{3}-\\d{3}$" },
    "year": { "type": "integer", "minimum": 100, "maximum": 199 },
    "title": { "type": "string", "minLength": 2, "maxLength": 100 },
    "className": { "type": "string", "minLength": 1, "maxLength": 100 },
    "instructor": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 20, "maxLength": 3000 },
    "districts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 30 }
    },
    "venue": { "type": "string", "minLength": 1, "maxLength": 150 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 30 }
    },
    "sdgs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 17,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^SDG (?:[1-9]|1[0-7])$" }
    },
    "displayOrder": { "type": "integer", "minimum": 1 },
    "internalNotes": { "type": ["string", "null"], "maxLength": 1000 },
    "publicNotes": { "type": ["string", "null"], "maxLength": 1000 },
    "coverAssetId": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "galleryAssetIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    }
  }
}

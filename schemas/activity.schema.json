{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.example/schemas/activity.schema.json",
  "title": "ActivityData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "year",
    "name",
    "startDate",
    "endDate",
    "dateLabel",
    "districts",
    "venue",
    "projectName",
    "activityType",
    "topic",
    "sdgs",
    "summary",
    "participants",
    "partnerOrganizations",
    "leader",
    "keywords",
    "videoUrl",
    "relatedUrl",
    "featured",
    "internalNotes",
    "publicNotes",
    "coverAssetId",
    "galleryAssetIds",
    "walkingRecord"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{3}-\\d{3}$" },
    "year": { "type": "integer", "minimum": 100, "maximum": 199 },
    "name": { "type": "string", "minLength": 2, "maxLength": 150 },
    "startDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "endDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "dateLabel": { "type": "string", "minLength": 1, "maxLength": 40 },
    "districts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 30 }
    },
    "venue": { "type": "string", "minLength": 1, "maxLength": 150 },
    "projectName": { "type": ["string", "null"], "maxLength": 150 },
    "activityType": { "type": "string", "minLength": 1, "maxLength": 50 },
    "topic": { "type": "string", "minLength": 1, "maxLength": 100 },
    "sdgs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 17,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^SDG (?:[1-9]|1[0-7])$" }
    },
    "summary": { "type": "string", "minLength": 20, "maxLength": 3000 },
    "participants": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 },
    "partnerOrganizations": { "type": ["string", "null"], "maxLength": 500 },
    "leader": { "type": ["string", "null"], "maxLength": 200 },
    "keywords": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 30 }
    },
    "videoUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
    "relatedUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
    "featured": { "type": "boolean" },
    "internalNotes": { "type": ["string", "null"], "maxLength": 1000 },
    "publicNotes": { "type": ["string", "null"], "maxLength": 1000 },
    "coverAssetId": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "galleryAssetIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "walkingRecord": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "titleOverride",
            "locationOverride",
            "summary",
            "routeSummary",
            "stops",
            "fieldNotes",
            "digitalWalkId",
            "coverAssetId"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["地方走讀", "聚落踏查", "流域觀察", "生態觀察", "訪談／口述", "文史採集", "產業地景", "其他"]
            },
            "titleOverride": { "type": ["string", "null"], "minLength": 1, "maxLength": 150 },
            "locationOverride": { "type": ["string", "null"], "minLength": 1, "maxLength": 300 },
            "summary": { "type": "string", "minLength": 20, "maxLength": 1500 },
            "routeSummary": { "type": ["string", "null"], "minLength": 1, "maxLength": 1500 },
            "stops": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "note"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 150 },
                  "note": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000 }
                }
              }
            },
            "fieldNotes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
            },
            "digitalWalkId": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
            "coverAssetId": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 }
          }
        }
      ]
    }
  }
}

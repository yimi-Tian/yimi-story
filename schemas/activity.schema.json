{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.example/schemas/activity.schema.json",
  "title": "ActivityData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "year",
    "name",
    "startDate",
    "endDate",
    "dateLabel",
    "districts",
    "venue",
    "projectName",
    "activityType",
    "topic",
    "sdgs",
    "summary",
    "participants",
    "partnerOrganizations",
    "leader",
    "keywords",
    "videoUrl",
    "relatedUrl",
    "featured",
    "internalNotes",
    "publicNotes",
    "coverAssetId",
    "galleryAssetIds"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{3}-\\d{3}$" },
    "year": { "type": "integer", "minimum": 100, "maximum": 199 },
    "name": { "type": "string", "minLength": 2, "maxLength": 150 },
    "startDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "endDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "dateLabel": { "type": "string", "minLength": 1, "maxLength": 40 },
    "districts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 30 }
    },
    "venue": { "type": "string", "minLength": 1, "maxLength": 150 },
    "projectName": { "type": ["string", "null"], "maxLength": 150 },
    "activityType": { "type": "string", "minLength": 1, "maxLength": 50 },
    "topic": { "type": "string", "minLength": 1, "maxLength": 100 },
    "sdgs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 17,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^SDG (?:[1-9]|1[0-7])$" }
    },
    "summary": { "type": "string", "minLength": 20, "maxLength": 3000 },
    "participants": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 },
    "partnerOrganizations": { "type": ["string", "null"], "maxLength": 500 },
    "leader": { "type": ["string", "null"], "maxLength": 200 },
    "keywords": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 30 }
    },
    "videoUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
    "relatedUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
    "featured": { "type": "boolean" },
    "internalNotes": { "type": ["string", "null"], "maxLength": 1000 },
    "publicNotes": { "type": ["string", "null"], "maxLength": 1000 },
    "coverAssetId": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "galleryAssetIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    }
  }
}

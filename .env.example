# Browser-safe configuration (placeholder values only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Edge Function only. Never expose this value to a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=server-only
# Local development placeholder only. Stage 4B must use the real deployed
# React admin HTTPS origin; never substitute GitHub Pages, localhost,
# Supabase Dashboard, or a made-up domain for production.
ADMIN_ALLOWED_ORIGIN=http://localhost:5173

# One-time Cloud baseline import safety gates. Keep real values in an ignored,
# access-restricted local file; never reuse the local importer identity in Cloud.
ALLOW_PRODUCTION_BASELINE_IMPORT=false
EXPECTED_SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_PROJECT_REF=your-project-ref
CONFIRM_PRODUCTION_BASELINE_IMPORT=your-project-ref
EXPECTED_SUPABASE_REGION=your-project-region
PRODUCTION_BASELINE_ACTOR_ID=00000000-0000-4000-8000-000000000000
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@your-region-pooler:6543/postgres

# Reserved for a later GitHub App phase. Unused in stage 2.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
